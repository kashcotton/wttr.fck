<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1: one line of everything, like At a Glance with an attitude. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_w_sun" />

    <TextView
        android:id="@+id/w_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:text="72°"
        android:textColor="@color/widget_on_surface"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/w_head"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="It's actually f*cking nice."
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/w_reroll"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button_bg"
        android:contentDescription="@string/widget_reroll"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_refresh"
        android:tint="@color/widget_on_primary" />
</LinearLayout>
